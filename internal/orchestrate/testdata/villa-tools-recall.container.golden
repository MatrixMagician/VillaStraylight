# ~/.config/containers/systemd/villa-tools-recall.container  (GENERATED — do not edit; source: config.toml)
[Unit]
Description=VillaStraylight tool server, recall search (OpenAPI, read-only)
After=villa-closed-network.service

[Container]
ContainerName=villa-tools-recall
Image=gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
Network=villa-closed.network
EnvironmentFile=%h/.config/villa/tools/recall.env
Volume=/home/villa/.local/bin/villa:/usr/local/bin/villa:ro,z
Volume=/home/villa/.local/share/villa/recall-scope:/villa/recall-scope:ro,z
Exec=/usr/local/bin/villa tools-serve --set recall --host 0.0.0.0 --port 8093 --embedding-model nomic-embed-text-v1.5

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
