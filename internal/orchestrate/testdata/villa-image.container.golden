# ~/.config/containers/systemd/villa-image.container  (GENERATED — do not edit; source: config.toml)
[Unit]
Description=VillaStraylight image generation (stable-diffusion.cpp sd-server, Vulkan RADV)
After=villa-network.service

[Container]
ContainerName=villa-image
Image=ghcr.io/leejet/stable-diffusion.cpp:master-vulkan@sha256:367ccc4e2b09e3c9948cb3b93bd530466547416722171409f968241c50659181
Network=villa.network
AddDevice=/dev/dri
GroupAdd=keep-groups
Volume=villa-models:/models:ro,z
PodmanArgs=--security-opt seccomp=unconfined
Entrypoint=/sd-server
Exec=--listen-ip 0.0.0.0 --listen-port 1234 --diffusion-model /models/z_image_turbo-Q8_0.gguf --llm /models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf --vae /models/z-image-turbo-ae.safetensors --backend Vulkan0 --params-backend Vulkan0 --eager-load --vae-tiling --diffusion-fa --cfg-scale 1 --steps 8 -W 1024 -H 1024

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
