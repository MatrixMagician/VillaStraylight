# ~/.config/containers/systemd/villa-tts.container  (GENERATED - do not edit; source: config.toml)
[Unit]
Description=VillaStraylight text-to-speech (Kokoro-FastAPI, CPU)
After=villa-network.service

[Container]
ContainerName=villa-tts
Image=ghcr.io/remsky/kokoro-fastapi-cpu:v0.9.0@sha256:7f9a256919eff7a84e9a77b757de0f3fe95c48fcf4fbe1e008deacbc7d9f2985
Network=villa.network
Environment=DOWNLOAD_MODEL=false
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
