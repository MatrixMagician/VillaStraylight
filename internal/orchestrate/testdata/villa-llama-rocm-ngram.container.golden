# ~/.config/containers/systemd/villa-llama.container  (GENERATED — do not edit; source: config.toml)
[Unit]
Description=VillaStraylight llama.cpp inference (ROCm 10.0 (HIP))
After=villa-network.service

[Container]
ContainerName=villa-llama
Image=docker.io/kyuz0/amd-strix-halo-toolboxes:rocm-10.0@sha256:3893b3e5474b7aaf0c4fab5632527f5fb4eef5c4a9f7e8eed8045fd20fc79bb1
Network=villa.network
EnvironmentFile=%h/.config/villa/inference/llama.env
AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=ROCBLAS_USE_HIPBLASLT=1
PublishPort=127.0.0.1:8080:8080
Volume=/home/villa/.local/share/villa/models:/models:ro,z
PodmanArgs=--security-opt seccomp=unconfined
Exec=llama-server -m /models/qwen3-35b-a3b-moe-64.gguf -c 131072 --host 0.0.0.0 --port 8080 -ngl 999 -fa 1 --load-mode none -lv 4 --metrics --cache-ram 8192 --spec-type ngram-mod

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
