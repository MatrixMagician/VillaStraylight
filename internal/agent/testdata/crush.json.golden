{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "disable_metrics": true,
    "disable_provider_auto_update": true,
    "disable_default_providers": true,
    "auto_lsp": false,
    "disabled_tools": [
      "fetch",
      "agentic_fetch",
      "download",
      "sourcegraph"
    ],
    "request_timeout": 328
  },
  "providers": {
    "villa": {
      "name": "VillaStraylight (local)",
      "type": "openai-compat",
      "base_url": "http://127.0.0.1:8080/v1",
      "api_key": "test-inference-secret",
      "models": [
        {
          "id": "villa-qwen3-coder-30b-a3b",
          "name": "qwen3-coder-30b-a3b (local)",
          "context_window": 65536,
          "default_max_tokens": 16384,
          "pricing": {
            "input": 0,
            "output": 0,
            "cache_create": 0,
            "cache_hit": 0
          },
          "capabilities": {
            "vision": false
          },
          "reasoning": {
            "thinking": "never"
          }
        }
      ]
    }
  },
  "lsp": {
    "go": {
      "command": "gopls"
    }
  },
  "permissions": {
    "allowed_tools": [
      "view",
      "edit",
      "write"
    ]
  }
}
