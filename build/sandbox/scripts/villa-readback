#!/usr/bin/env python3
"""villa-readback: openpyxl data_only=True dump of a recalculated workbook.

The read-back is part of an xlsx task's proof, not a courtesy (spec v1.11
§7): a task is not done until the recalculated values were read and
compared. This prints one "sheet\tcell\tvalue" line per non-empty cell,
sorted for a stable diff, writes the same dump to <stem>.readback.txt next
to the input (or under --outdir), and prints that path as the last line so
the model can chain it.
"""
import sys
import os

try:
    from openpyxl import load_workbook
except ImportError:
    print("villa-readback: openpyxl is not installed", file=sys.stderr)
    sys.exit(1)


def usage():
    print("usage: villa-readback <workbook.xlsx> [--outdir DIR]", file=sys.stderr)
    sys.exit(1)


def main(argv):
    outdir = None
    input_path = None
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--outdir":
            if i + 1 >= len(argv):
                usage()
            outdir = argv[i + 1]
            i += 2
        elif arg.startswith("-"):
            usage()
        else:
            if input_path is not None:
                usage()
            input_path = arg
            i += 1
    if input_path is None:
        usage()
    if not os.path.isfile(input_path):
        print(f"villa-readback: no such file: {input_path}", file=sys.stderr)
        return 1

    try:
        wb = load_workbook(input_path, data_only=True)
    except Exception as exc:  # openpyxl raises several exception types on bad input
        print(f"villa-readback: could not open workbook: {exc}", file=sys.stderr)
        return 1

    rows = []
    for ws in wb.worksheets:
        for row in ws.iter_rows():
            for cell in row:
                if cell.value is None:
                    continue
                rows.append((ws.title, cell.coordinate, cell.value))
    rows.sort(key=lambda r: (r[0], r[1]))

    lines = [f"{sheet}\t{coord}\t{value}" for sheet, coord, value in rows]

    directory = outdir or os.path.dirname(input_path) or "."
    os.makedirs(directory, exist_ok=True)
    stem = os.path.splitext(os.path.basename(input_path))[0]
    out_path = os.path.join(directory, f"{stem}.readback.txt")
    with open(out_path, "w") as f:
        f.write("\n".join(lines) + ("\n" if lines else ""))

    for line in lines:
        print(line)
    print(out_path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
